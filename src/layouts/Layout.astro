---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/assets/9.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Potli- We fill it with meaning</title>
	</head>
	<body>
		<div id="site-loader" class="site-loader" aria-hidden="true">
			<img src="/assets/POTLI Logo.png" alt="Potli Logo" class="h-28 md:h-44 w-fit pl-5 md:pl-10 md:pt-0 pt-4" />
		</div>
		<div id="smooth-wrapper">
			<main id="smooth-content">
				<slot />
			</main>
		</div>

		<script>
			// @ts-nocheck
			import { gsap } from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";
			import { ScrollSmoother } from "gsap/ScrollSmoother";

			gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

			const initSmoothScroll = () => {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				if (typeof ScrollSmoother?.create !== "function") return;

				const existing = ScrollSmoother.get();
				if (existing) existing.kill();

				ScrollTrigger.getById("hero-sticky-pin")?.kill();

				ScrollSmoother.create({
					wrapper: "#smooth-wrapper",
					content: "#smooth-content",
					smooth: 2,
					smoothTouch: 0.8,
					normalizeScroll: true,
					effects: false,
				});

				const hero = document.querySelector("[data-hero-sticky]");
				if (hero) {
					ScrollTrigger.create({
						id: "hero-sticky-pin",
						trigger: hero,
						start: "top top",
						end: "max",
						pin: true,
						pinSpacing: false,
						anticipatePin: 1,
					});
				}

				ScrollTrigger.refresh();
			};

			const start = () => requestAnimationFrame(initSmoothScroll);

			if (document.readyState === "complete") {
				start();
			} else {
				window.addEventListener("load", start, { once: true });
			}

			document.addEventListener("astro:page-load", start);

			const LOADER_DURATION_MS = 3000;
			const LOADER_FADE_DURATION = 0;
			const LOGO_MOVE_DURATION = 1.6;

			const runLoaderTransition = () => {
				const loader = document.getElementById("site-loader");
				if (!loader) return;

				document.documentElement.classList.add("is-loading");

				const cleanup = () => {
					loader.remove();
					document.documentElement.classList.remove("is-loading");
				};

				const startTransition = () => {
					const heroLogo = document.getElementById("hero-logo");
					if (!heroLogo) {
						gsap.to(loader, { opacity: 0, duration: LOADER_FADE_DURATION, onComplete: cleanup });
						return;
					}

					const heroRect = heroLogo.getBoundingClientRect();
					const heroCenterX = heroRect.left + heroRect.width / 2;
					const heroCenterY = heroRect.top + heroRect.height / 2;
					const viewportCenterX = window.innerWidth / 2;
					const viewportCenterY = window.innerHeight / 2;
					const fromX = viewportCenterX - heroCenterX;
					const fromY = viewportCenterY - heroCenterY;

					heroLogo.style.willChange = "transform";
					gsap.timeline({
						onComplete: () => {
							heroLogo.style.willChange = "";
							cleanup();
						},
					})
						.to(loader, { opacity: 0, duration: LOADER_FADE_DURATION }, 0)
						.from(
							heroLogo,
							{ x: fromX, y: fromY, duration: LOGO_MOVE_DURATION, ease: "power3.inOut" },
							0
						);
				};

				window.setTimeout(() => {
					try {
						startTransition();
					} catch (error) {
						gsap.to(loader, { opacity: 0, duration: LOADER_FADE_DURATION, onComplete: cleanup });
					}
				}, LOADER_DURATION_MS);
			};

			if (document.readyState === "complete") {
				runLoaderTransition();
			} else {
				window.addEventListener("load", runLoaderTransition, { once: true });
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	#smooth-wrapper {
		position: relative;
		overflow: hidden;
	}

	main#smooth-content {
		min-height: 100vh;
		width: 100%;
		overflow-x: clip;
	}
</style>
