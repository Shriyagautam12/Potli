---
import '../styles/global.css'
import 'locomotive-scroll/dist/locomotive-scroll.css'
import locoscrollScript from '../scripts/locoscroll.js?url'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/assets/9.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Potli- We fill it with meaning</title>
	</head>
	<body>
		<main data-scroll-container>
			<slot />
		</main>

		<script type="module" src={locoscrollScript}></script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	main[data-scroll-container] {
		min-height: 100vh;
		width: 100%;
		overflow-x: clip;
	}
</style>
