---
// Testimonial.astro
import {Star} from "@lucide/astro"
---

<section class="bg-[#EFEAE5] py-28 z-20 relative" id="testimonial">
  <div class=" flex flex-col items-center gap-2 md:gap-4">
    <div class="flex gap-1">

      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
    </div>
    <h2 class="text-4xl md:text-5xl md:w-auto w-4/5 mx-auto font-medium tracking-tight text-center">
      Potli transformed our brand into a powerful <br>
      presence allowing us to <span class="text-[#696765]">work with the best.</span>
    </h2>
  </div>

  <div class="mt-6 md:mt-6 flex flex-col gap-4 md:gap-0">
    
    
  <div class="w-[85%] md:w-1/2 max-w-full mx-auto overflow-x-hidden">
    <div class="brand-marquee-track pt-6 pb-8">
      <div class="brand-marquee-group">
        <img src="/assets/111Skin.png" alt="111Skin" class="h-[40px] md:h-[60px]" />
        <img src="/assets/logo_brand.jpg" alt="Brand 2" class="h-[40px] md:h-[60px]" />
        <img src="/assets/lulu.png" alt="Brand 3" class="h-[40px] md:h-[60px]" />
        <img src="/assets/TalimiMela.png" alt="Brand 4" class="h-[40px] md:h-[60px]" />
        <img src="/assets/JamiaLogo.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/Sukhbir.png" alt="Brand 5" class="h-[40px] md:h-auto md:w-[90px]" />
        <img src="/assets/RoseminWorld.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/ChaiWaliT.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/ChayCompany.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/Barbeque.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
      </div>
      <div class="brand-marquee-group" aria-hidden="true">
        <img src="/assets/111Skin.png" alt="" class="h-[40px] md:h-[60px]" />
        <img src="/assets/logo_brand.jpg" alt="" class="h-[40px] md:h-[60px]" />
        <img src="/assets/lulu.png" alt="" class="h-[40px] md:h-[60px]" />
        <img src="/assets/TalimiMela.png" alt="" class="h-[40px] md:h-[60px]" />
        <img src="/assets/JamiaLogo.png" alt="" class="h-[40px] md:h-[60px]" />
        <img src="/assets/Sukhbir.png" alt="Brand 5" class="h-[40px] md:h-auto md:w-[90px]" />
        <img src="/assets/RoseminWorld.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/ChaiWaliT.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/ChayCompany.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
        <img src="/assets/Barbeque.png" alt="Brand 5" class="h-[40px] md:h-[60px]" />
      </div>
      </div>
    </div>
    <p class="text-xl font-light text-center text-[#696765] ">Elevating brands that define luxury and excellence.</p>
  </div>

  </div>
</section>
