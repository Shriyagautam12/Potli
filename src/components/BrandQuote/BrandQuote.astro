---
// Testimonial.astro
---

<section class="testimonial-section" id="testimonial">
  <div class="testimonial-content">
    <div class="stars">
      ★★★★★
    </div>
    <h2>
      Timeless transformed our brand into a powerful 
      presence allowing us to <span class="highlight-gray">work with the best.</span>
    </h2>
    <p class="author">– Luxe & Co.</p>
  </div>

  <div class="brands-section">
    <p class="brands-text">Elevating brands that define luxury and excellence:</p>
    
    <div class="carousel-container">
      <div class="carousel">
        <div class="brand-logo">Amsterdam</div>
        <div class="brand-logo">venice.</div>
        <div class="brand-logo script">that</div>
        <div class="brand-logo dots">••</div>
        <div class="brand-logo bold">M</div>
        <!-- Duplicate for seamless loop -->
        <div class="brand-logo">Amsterdam</div>
        <div class="brand-logo">venice.</div>
        <div class="brand-logo script">that</div>
        <div class="brand-logo dots">••</div>
        <div class="brand-logo bold">M</div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-section {
    min-height: 80vh; /* Reduced from 100vh */
    background: #f5f1ed;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 2rem; /* Reduced padding */
    position: relative;
    z-index: 5; /* Higher than hero but lower than what-we-do */
    transform: translateZ(0); /* Force hardware acceleration and create stacking context */
    isolation: isolate; /* Create new stacking context */
    backface-visibility: hidden; /* Prevent flickering */
    -webkit-backface-visibility: hidden; /* Safari support */
  }

  .testimonial-content {
    text-align: center;
    max-width: 900px;
    margin-bottom: 2rem; /* Reduced from 4rem */
  }

  .stars {
    font-size: 2rem;
    color: #111;
    margin-bottom: 2rem;
    letter-spacing: 0.2rem;
  }

  h2 {
    font-size: 2.5rem;
    line-height: 1.2;
    color: #111;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .highlight-gray {
    color: #888;
  }

  .author {
    font-size: 1.1rem;
    color: #666;
    font-style: italic;
    margin-bottom: 0;
  }

  .brands-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
  }

  .brands-text {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 2rem; /* Reduced from 3rem */
  }

  .carousel-container {
    overflow: hidden;
    width: 50%;
    position: relative;
  }

  .carousel {
    display: flex;
    align-items: center;
    gap: 4rem;
    animation: scroll 20s linear infinite;
    width: fit-content;
  }

  .brand-logo {
    font-size: 1.8rem;
    color: #333;
    white-space: nowrap;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .brand-logo:hover {
    opacity: 1;
  }

  .brand-logo.script {
    font-style: italic;
    font-family: cursive;
  }

  .brand-logo.dots {
    font-size: 2.5rem;
    letter-spacing: 0.5rem;
  }

  .brand-logo.bold {
    font-weight: 900;
    font-size: 2.2rem;
    background: #111;
    color: white;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Responsive design */
  @media (max-width: 768px) {
    h2 {
      font-size: 2rem;
    }

    .carousel {
      gap: 2rem;
    }

    .brand-logo {
      font-size: 1.4rem;
    }

    .testimonial-section {
      padding: 3rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    h2 {
      font-size: 1.6rem;
    }

    .brand-logo {
      font-size: 1.2rem;
    }

    .carousel {
      gap: 1.5rem;
    }
  }
</style>

<script>
  // Optimized counter-parallax effect for testimonial section
  let ticking = false;
  let lastScrollY = 0;

  function updateTestimonialParallax() {
    const scrolled = window.pageYOffset;
    const testimonial = document.getElementById('testimonial') as HTMLElement;
    const hero = document.querySelector('#hero') as HTMLElement;
    
    // Only update if scroll has changed significantly
    if (Math.abs(scrolled - lastScrollY) < 1) {
      ticking = false;
      return;
    }
    
    if (testimonial && hero) {
      const heroHeight = hero.offsetHeight;
      
      if (scrolled > heroHeight * 0.05) { // Start earlier for smoother transition
        const testimonialOffset = (scrolled - heroHeight * 0.05) * 0.4; // Further reduced intensity
        testimonial.style.transform = `translate3d(0, -${testimonialOffset}px, 0)`;
        testimonial.style.willChange = 'transform';
      } else {
        testimonial.style.transform = 'translate3d(0, 0, 0)';
        testimonial.style.willChange = 'auto';
      }
    }
    
    lastScrollY = scrolled;
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateTestimonialParallax);
      ticking = true;
    }
  }

  if (typeof window !== 'undefined') {
    // Throttle scroll events
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      requestTick();
      
      // Clean up after scroll stops
      scrollTimeout = setTimeout(() => {
        const testimonial = document.getElementById('testimonial') as HTMLElement;
        if (testimonial) {
          testimonial.style.willChange = 'auto';
        }
      }, 150);
    }, { passive: true });
    
    updateTestimonialParallax();
    
    window.addEventListener('beforeunload', () => {
      window.removeEventListener('scroll', requestTick);
    });
  }
</script>