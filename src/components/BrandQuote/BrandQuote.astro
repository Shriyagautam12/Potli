---
// Testimonial.astro
import { Star } from "@lucide/astro";
---

<section class="bg-[#EFEAE5] py-28 z-20 relative" id="testimonial">
  <div class="flex flex-col items-center gap-2 md:gap-4">
    <div class="flex gap-1">
      <Star class="w-4 md:w-8" fill="#000" />
      <Star class="w-4 md:w-8" fill="#000" />
      <Star class="w-4 md:w-8" fill="#000" />
      <Star class="w-4 md:w-8" fill="#000" />
      <Star class="w-4 md:w-8" fill="#000" />
    </div>
    <h2
      class="text-4xl md:text-5xl md:w-auto w-4/5 mx-auto font-medium tracking-tight text-center"
    >
      Potli transformed our brand into a powerful <br />
      presence allowing us to <span class="text-[#696765]"
        >work with the best.</span
      >
    </h2>
    <p class="text-[#696765] text-base md:text-lg font-medium">
      – The Chay Company
    </p>
  </div>

  <div class="mt-6 md:mt-14 flex flex-col gap-4 md:gap-0">
