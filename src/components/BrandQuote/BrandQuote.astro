---
// Testimonial.astro
import {Star} from "@lucide/astro"
---

<section class="bg-[#EFEAE5] py-28 z-20 relative" id="testimonial">
  <div class=" flex flex-col items-center gap-2 md:gap-4">
    <div class="flex gap-1">

      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
      <Star  class="w-4 md:w-8"  fill="#000"/>
    </div>
    <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-center">
      Potli transformed our brand into a powerful <br>
      presence allowing us to <span class="text-[#696765]">work with the best.</span>
    </h2>
    <p class="text-[#696765] text-base md:text-lg font-medium">– Luxe & Co.</p>
  </div>

  <div class="mt-6 md:mt-12 flex flex-col gap-4 md:gap-0">
    <p class="text-xl font-light text-center text-[#696765] ">Elevating brands that define luxury and excellence:</p>
    
  <div class="w-[85%] md:w-1/2 max-w-full mx-auto relative flex overflow-x-hidden">
  <div class="flex min-w-max gap-6  md:gap-16 px-3 md:px-8 justify-center animate-marquee py-6 whitespace-nowrap">

    <img src="/assets/111Skin.png" alt="111Skin" class="h-[40px] md:h-[60px] " />
    <img src="/assets/logo_brand.jpg" alt="Brand 2" class="h-[40px] md:h-[60px] " />
    <img src="/assets/lulu.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
     <img src="/assets/2.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
      <img src="/assets/3.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
</div>
  <div class="flex min-w-max gap-6  md:gap-16 px-3 md:px-8 justify-center absolute top-0 animate-marquee2 py-6 whitespace-nowrap">

    <img src="/assets/111Skin.png" alt="111Skin" class="h-[40px] md:h-[60px] " />
    <img src="/assets/logo_brand.jpg" alt="Brand 2" class="h-[40px] md:h-[60px] " />
    <img src="/assets/lulu.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
     <img src="/assets/2.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
      <img src="/assets/3.png" alt="Brand 3" class="h-[40px] md:h-[60px] " />
</div>

</div>

  </div>
</section>
