---
// Portfolio.astro
// Props: projects array (image, title, subtitle, category, link)
const projects = [
  {
    image: "/lumina.jpg",
    title: "Lumina",
    subtitle: "Electric Vehicle",
    category: "Visual Identity",
    link: "#"
  },
  {
    image: "/velour.jpg",
    title: "Velour",
    subtitle: "Coffee Beans",
    category: "Brand Strategy",
    link: "#"
  },
  {
    image: "/aether.jpg",
    title: "Aether",
    subtitle: "Luxury Skincare",
    category: "Packaging",
    link: "#"
  },
  {
    image: "/nova.jpg",
    title: "Nova",
    subtitle: "Smartwatch",
    category: "UI/UX",
    link: "#"
  }
];
---

<section class="portfolio">
  <div class="container">
    <!-- Heading -->
    <div class="heading">
      <h2>Our work speaks for itself</h2>
      <p>
        Explore our portfolio of refined, timeless branding projects that leave a lasting impression.
      </p>
      <a href="/work" class="btn">View all work →</a>
    </div>

    <!-- Grid -->
    <div class="grid">
      {projects.map(project => (
        <a href={project.link} class="card">
          <div class="image-wrapper">
            <img src={project.image} alt={project.title} />
            <div class="icon">↗</div>
          </div>
          <h3>{project.title}</h3>
          <p class="subtitle">{project.subtitle}</p>
          <span class="tag">{project.category}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.portfolio {
  padding: 5rem 1rem;
  text-align: center;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.heading {
  margin-bottom: 3rem;
}

.heading h2 {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.heading p {
  color: #666;
  margin-bottom: 1.5rem;
}

.btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  background: #f5f5f5;
  border-radius: 999px;
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  color: black;
  transition: background 0.2s;
}

.btn:hover {
  background: #e9e9e9;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
  gap: 2rem;
}

.card {
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-decoration: none;
  color: inherit;
}

.image-wrapper {
  position: relative;
  border-radius: 1rem;
  overflow: hidden;
}

.image-wrapper img {
  width: 100%;
  display: block;
  border-radius: 1rem;
  transition: transform 0.3s ease;
}

.image-wrapper:hover img {
  transform: scale(1.03);
}

.icon {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: white;
  border-radius: 50%;
  padding: 0.4rem 0.6rem;
  font-size: 0.9rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.image-wrapper:hover .icon {
  opacity: 1;
}

.card h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-top: 0.75rem;
}

.subtitle {
  font-size: 0.9rem;
  color: #666;
}

.tag {
  display: inline-block;
  margin-top: 0.5rem;
  padding: 0.35rem 0.75rem;
  font-size: 0.8rem;
  border-radius: 999px;
  background: #eee;
  color: #333;
}
</style>
