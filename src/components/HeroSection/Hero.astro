---
// Hero.astro
import {ArrowRight} from "@lucide/astro";
---

<section class="h-screen flex flex-col text-black  sticky top-0 w-full z-10">
  <!-- Logo in top left corner -->
  <img src="/assets/logo.png" alt="Potli Logo" class="h-44 w-fit pl-12" />

  <!-- Text content on the left -->
  <div class="flex flex-col pl-16 gap-8" id="herodiv">
    <div class="text-white bg-[#A1806E] text-sm font-semibold tracking-tight rounded-full flex w-fit px-3 pt-0.5 pb-1 items-center justify-center">Accepting new projects</div>
    <h1 class="text-6xl font-medium tracking-tight">
      Creating 
      brands<br  /> that <span class=" text-[#574F48]">inspire.</span>
    </h1>
    <p class="text-[#574F48] text-xl font-semibold">
      Expertly crafted brand experiences that captivate, connect <br>
      with discerning audiences, and leave a lasting impression.
    </p>
    <a href="mailto:gautamshriya5@gmail.com" class=" group rounded-full relative z-50 cursor-pointer bg-[#EFEAE5] transition-all duration-200 ease-in-out hover:bg-[#e7e1db] font-semibold w-fit flex items-center"><p class="px-6 py-3.5 ">Get in touch</p> <span class="rounded-full bg-white p-3 mr-1"><ArrowRight color="#000000" size={"20px"}/></span>
    <div class="bg-white w-12 h-12 -z-10  group-hover:w-[calc(100%-0.5rem)] group-hover:h-[calc(100%-0.5rem)] transition-[width,height] duration-700 ease-in-out flex absolute rounded-full right-1 top-1/2 -translate-y-1/2 will-change-[width,height]"></div>
  </a>
  </div>

  <!-- Video container on the right -->
   <div class="static md:absolute w-full md:w-auto  -z-10 bg-[#BEAB9A] overflow-hidden"><div class="">
    <video class="md:translate-x-1/4 h-full md:h-auto rotate-90 md:rotate-0" autoplay loop muted playsinline>
      <source src="/assets/bg.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div></div>
  
</section>
