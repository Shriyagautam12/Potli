---
// Hero.astro
---

<section class="hero" id="hero">
  <!-- Logo in top left corner -->
  <img src="/assets/logo.png" alt="Potli Logo" class="logo" />

  <!-- Text content on the left -->
  <div class="content">
    <span class="badge">Accepting new projects</span>
    <h1>
      Creating <br class="desktop-break" />
      brands that <span class="highlight">inspire.</span>
    </h1>
    <p>
      Expertly crafted brand experiences that captivate, connect 
      with discerning audiences, and leave a lasting impression.
    </p>
    <a href="mailto:gautamshriya5@gmail.com" class="btn">Get in touch →</a>
  </div>

  <!-- Video container on the right -->
  <div class="video-container">
    <video class="bg-video" autoplay loop muted playsinline>
      <source src="/assets/bg.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>
</section>

<style>
  .hero {
    height: 90vh;
    display: flex;
    align-items: center;
    background: #c5b3a4;
    overflow: hidden;
    position: relative;
    z-index: 1;
    transform: translateZ(0);
    isolation: isolate;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .logo {
    position: absolute;
    top: 0rem;
    left: 0rem;
    width: 150px;
    height: auto;
    z-index: 10;
  }

  .content {
    flex: 1;
    max-width: 600px;
    padding: 2rem 4rem 2rem 2rem;
    color: #111;
    z-index: 3;
    position: relative;
  }

  .video-container {
    flex: 1;
    height: 100%;
    position: relative;
    overflow: hidden;
    z-index: 2;
  }

  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    position: absolute;
    top: 0;
    left: 0;
  }

  .badge {
    display: inline-block;
    background: #b68b6f;
    color: white;
    padding: 0.5rem 1.2rem;
    border-radius: 2rem;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 58px;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    font-weight: 600;
  }

  .desktop-break {
    display: block;
  }

  .highlight {
    color: #7a6c57;
  }

  p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #444;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    background: #111;
    color: white;
    padding: 0.9rem 1.8rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    gap: 0.5rem;
  }

  .btn:hover {
    background: #333;
    transform: translateY(-1px);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      height: 100vh;
      min-height: 100vh;
      justify-content: center;
      padding: 0 1.5rem;
    }

    .logo {
      width: 120px;
      top: 2rem;
      left: 50%;
      transform: translateX(-50%);
    }

    .content {
      padding: 0;
      text-align: center;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .desktop-break {
      display: none;
    }

    .badge {
      font-size: 0.9rem;
      padding: 0.6rem 1.4rem;
      margin-bottom: 2rem;
    }

    .video-container {
      display: none;
    }

    h1 {
      font-size: 2.8rem;
      line-height: 1.15;
      margin-bottom: 1.5rem;
    }

    .highlight {
      color: #8b7a64;
    }

    p {
      font-size: 1.05rem;
      line-height: 1.65;
      max-width: 90%;
      color: #5a5a5a;
      margin-bottom: 2.5rem;
    }

    .btn {
      padding: 0.85rem 1.6rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 0 1.25rem;
    }

    .logo {
      width: 100px;
      top: 1.5rem;
    }

    .badge {
      font-size: 0.85rem;
      padding: 0.55rem 1.2rem;
    }

    h1 {
      font-size: 2.2rem;
      margin-bottom: 1.25rem;
    }

    p {
      font-size: 1rem;
      margin-bottom: 2rem;
      max-width: 95%;
    }

    .btn {
      padding: 0.8rem 1.5rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 380px) {
    .logo {
      width: 85px;
      top: 1.25rem;
      left: 15%;
    }

    h1 {
      font-size: 1.9rem;
    }

    p {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // Optimized parallax effect for hero section
  let ticking = false;
  let lastScrollY = 0;

  function updateHeroParallax() {
    const scrolled = window.pageYOffset;
    const hero = document.getElementById('hero');
    
    if (Math.abs(scrolled - lastScrollY) < 1) {
      ticking = false;
      return;
    }
    
    if (hero) {
      const heroHeight = hero.offsetHeight;
      const parallaxSpeed = 0.3;
      
      if (scrolled < heroHeight * 1.2) {
        const offset = scrolled * parallaxSpeed;
        hero.style.transform = `translate3d(0, ${offset}px, 0)`;
        hero.style.willChange = 'transform';
      } else {
        hero.style.transform = 'translate3d(0, 0, 0)';
        hero.style.willChange = 'auto';
      }
    }
    
    lastScrollY = scrolled;
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateHeroParallax);
      ticking = true;
    }
  }

  if (typeof window !== 'undefined') {
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      requestTick();
      
      scrollTimeout = setTimeout(() => {
        const hero = document.getElementById('hero');
        if (hero) {
          hero.style.willChange = 'auto';
        }
      }, 150);
    }, { passive: true });
    
    updateHeroParallax();
  
    window.addEventListener('beforeunload', () => {
      window.removeEventListener('scroll', requestTick);
    });
  }
</script>