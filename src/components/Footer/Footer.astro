---
// Footer.astro
import {ArrowRight} from "@lucide/astro";
---

<section class="hero z-20 relative h-[115vh] w-full bg-[#C7A697] md:bg-[#BEAB9A] overflow-hidden text-[#111]">
  <div class="absolute inset-x-0 top-[50%] -translate-y-1/2 w-full">
    <div class="h-[20rem] "></div>
      <video autoplay loop muted playsinline class="md:block hidden w-full h-auto max-h-[110vh] object-contain pb-4 [transform:translateZ(0)] blur-[0.4px]">
        <source src="/assets/footer.mp4" type="video/mp4" class="h-full w-full" />
          Your browser does not support the video tag.
        </video>
</div>
    <!-- <video autoplay loop muted playsinline class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-1/2 object-cover">
    <source src="/assets/footer.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video> -->

  <div class="relative z-20  flex flex-col justify-between h-full p-8">
    <div class="text-center mt-10 items-center flex flex-col">
      <h2 class="text-5xl md:text-6xl font-medium tracking-tight">
        Create a brand that <br />
        stands the test of <span class="text-[#574F48]">time.</span>
      </h2>
      <p class="my-4 text-[#333] text-lg">
        Potli designs. Lasting impressions. Let’s craft a brand that endures and inspires.
      </p>
      <a href="/contact#reach" class=" group rounded-full relative z-50  bg-[#EFEAE5] transition-all duration-200 ease-in-out hover:bg-[#e7e1db] font-semibold w-fit flex items-center"><p class="px-6 py-3.5 ">Get in touch</p> <span class="rounded-full bg-white p-3 mr-1"><ArrowRight color="#000000" size={"20px"}/></span>
    <div class="bg-white w-12 h-12 -z-10  group-hover:w-[calc(100%-0.5rem)] group-hover:h-[calc(100%-0.5rem)] transition-[width,height] duration-700 ease-in-out flex absolute rounded-full right-1 top-1/2 -translate-y-1/2 will-change-[width,height]"></div>
  </a>
    </div>
     <!-- Footer -->
    <div class="mt-10 flex items-center justify-between pt-6 text-sm">

      <span>
        © 2026 Potli. We fill it with meaning.
      </span>

      <div class="hidden md:flex gap-8">
        <a href="/" class="hover:text-[#574F48]">Home</a>
        <a href="/about-us" class="hover:text-[#574F48]">About</a>
        <a href="/awards" class="hover:text-[#574F48]">Awards</a>
        <a href="/career" class="hover:text-[#574F48]">Career</a>
        <a href="/contact" class="hover:text-[#574F48]">Contact</a>
      </div>

    </div>
  </div>
  <div class="block md:hidden absolute z-10 bottom-0 left-0 right-0 h-[34vh] pointer-events-none overflow-hidden">
  <div class="absolute top-0 left-0 right-0 z-20 h-10 bg-gradient-to-b from-[#C7A697]/95 via-[#C7A697]/70 to-transparent backdrop-blur-sm"></div>
  <video class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-[18%] rotate-90 h-[450px] w-auto max-w-none bg-[#C7A697] md:bg-[#BEAB9A]" autoplay loop muted playsinline>
    <source src="/assets/bg.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</div>
</section>
