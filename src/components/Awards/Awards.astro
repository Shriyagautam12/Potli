<section class="awards-section">
  <div class="awards-header">
    <p class="eyebrow">AWARDS & Recognitions</p>
    <h2>Only The Best For You</h2>
  </div>
<a href="/awards" class="award-card">
  <div class="award-circle">
    <span>2024</span>
  </div>
  <p class="award-title">Branding Partner</p>
</a>

   
  
  </div>
</section>

<style>
  .awards-section {
    padding: 6rem 2rem;
    background: #fff;
    text-align: center;
  }
  .award-card {
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.award-card:hover .award-circle {
  transform: scale(1.05);
  border-color: #b8a890;
}

.award-circle {
  transition: transform 0.3s ease, border-color 0.3s ease;
}


  /* Header */
  .awards-header {
    margin-bottom: 4rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #999;
    margin-bottom: 0.75rem;
  }

  .awards-header h2 {
    font-size: 2.2rem;
    font-weight: 500;
    color: #111;
  }

  /* Grid */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Card */
  .award-card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Dotted Circle */
  .award-circle {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px dashed #d6c6ae;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .award-circle span {
    font-size: 1rem;
    color: #b8a890;
    letter-spacing: 0.1em;
  }

  .award-title {
    font-size: 1rem;
    color: #666;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .awards-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
