---
// FeaturesBasic.astro
// Using icons from Tabler Icons (you can swap with any SVG/icon set you prefer)
---

<section class="pb-48 pt-12 z-20 relative bg-white">
  <div class="w-4/5 mx-auto">
    <!-- Heading -->
    <div class="">
      <h2 class="text-5xl font-medium tracking-tight text-[#1a1a1a] text-center">Going beyond the basics</h2>
      <p class="text-[#666] text-xl text-center mt-4 mb-20">
        Extraordinary features that elevate your branding experience and deliver lasting results.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-3 gap-16">
      <!-- Feature 1 -->
      <div class="flex flex-col items-center gap-4">
        <div class="icon">
          <!-- Menu Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </div>
        <h3 class="font-medium text-lg">Dedicated Client Portal</h3>
        <p class="text-[#818181] text-center">Track progress and collaborate through our client portal.</p>
      </div>

      <!-- Feature 2 -->
      <div class="flex flex-col items-center gap-4">
        <div class="icon">
          <!-- Vector Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="6" height="6"/>
            <rect x="15" y="3" width="6" height="6"/>
            <rect x="3" y="15" width="6" height="6"/>
            <rect x="15" y="15" width="6" height="6"/>
          </svg>
        </div>
        <h3 class="font-medium text-lg">Bespoke Brand Guidelines</h3>
        <p class="text-[#818181] text-center">Get a detailed guide to keep your brand consistent across every platform.</p>
      </div>

      <!-- Feature 3 -->
      <div class="flex flex-col items-center gap-4">
        <div class="icon">
          <!-- User Icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="7" r="4"/>
            <path d="M5.5 21a7.5 7.5 0 0 1 13 0"/>
          </svg>
        </div>
        <h3 class="font-medium text-lg">Post-Launch Support</h3>
        <p class="text-[#818181] text-center">We’re here to help refine and adapt your brand as your business evolves.</p>
      </div>
    </div>
  </div>
</section>

