---
// FeaturesBasic.astro
// Using icons from Tabler Icons (you can swap with any SVG/icon set you prefer)
import {TextAlignJustify,LayoutGrid,User} from "@lucide/astro"
---

<section class="pb-48 pt-12 z-20 relative bg-white">
  <div class="w-4/5 mx-auto">
    <!-- Heading -->
    <div class="">
      <h2 class="text-4xl font-medium tracking-tight text-[#1a1a1a] text-center">Going beyond the basics</h2>
      <p class="text-[#666] text-base md:text-xl text-center mt-2 md:mt-4 mb-16 md:w-auto w-4/5 mx-auto">
        Extraordinary features that elevate your branding experience and deliver lasting results.
      </p>
    </div>

    <!-- Features grid -->
    <div id="feature-container" class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <!-- Feature 1 -->
      <div class="feature-card flex flex-col items-center gap-4">
        <div class="icon">
          <!-- Menu Icon -->
          <TextAlignJustify size="40px"/>
        </div>
        <h3 class="font-medium text-lg">Dedicated Client Portal</h3>
        <p class="text-[#818181] text-center">Track progress and collaborate through our client portal.</p>
      </div>

      <!-- Feature 2 -->
      <div class="feature-card flex flex-col items-center gap-4">
        <div class="icon">
          <!-- Vector Icon -->
          <LayoutGrid size="40px"/>
        </div>
        <h3 class="font-medium text-lg">Bespoke Brand Guidelines</h3>
        <p class="text-[#818181] text-center">Get a detailed guide to keep your brand consistent across every platform.</p>
      </div>

      <!-- Feature 3 -->
      <div class="feature-card flex flex-col items-center gap-4">
        <div class="icon">
          <!-- User Icon -->
          <User size="40px"/>
        </div>
        <h3 class="font-medium text-lg">Post-Launch Support</h3>
        <p class="text-[#818181] text-center">We’re here to help refine and adapt your brand as your business evolves.</p>
      </div>
    </div>
  </div>
</section>
