---
// WhatWeDo.astro
import {Eye,MoveDiagonal,TextAlignStart} from "@lucide/astro"
---

<section class="bg-[#fafafa] py-20 z-20 relative">
  <div id="" class="mx-auto px-6">
    <h2 class="text-4xl font-medium tracking-tight text-[#1a1a1a] text-center">What we do</h2>
    <p class="text-[#666] text-base md:text-xl text-center mt-2 md:mt-4 mb-16 md:w-auto w-4/5 mx-auto">Bespoke services are designed to elevate your brand.</p>
    
    <div id="container2" class="grid grid-cols-1 md:grid-cols-3 max-w-6xl gap-8 mx-auto ">
      <div class="whatwedo-card bg-[#f3f0ee] py-10 px-8 rounded-2xl ">
        <div class="flex h-14 w-14 bg-[#a1806f] rounded-full text-white items-center justify-center mb-10">
          <MoveDiagonal size="24px"/>
        </div>
        <h3 class="text-xl tracking-tight font-semibold text-[#1a1a1a] mb-4">Brand Strategy</h3>
        <p class="text-lg text-[#666]   ">Developing a tailored roadmap that defines your brand's voice, vision, and positioning in the luxury market.</p>
      </div>
      
      <div class="whatwedo-card bg-[#f3f0ee] py-10 px-8 rounded-2xl whatwedo-card">
        <div class="flex h-14 w-14 bg-[#a1806f] rounded-full text-white items-center justify-center mb-10">
          <Eye size="24px"/>
        </div>
        <h3 class="text-xl tracking-tight font-semibold text-[#1a1a1a] mb-4">Visual Identity</h3>
        <p class="text-lg text-[#666]   ">Creating iconic logos, color palettes, and design elements that embody your brand's unique character.</p>
      </div>
      
      <div class="whatwedo-card bg-[#f3f0ee] py-10 px-8 rounded-2xl ">
        <div class="flex h-14 w-14 bg-[#a1806f] rounded-full text-white items-center justify-center mb-10">
          <TextAlignStart size="24px"/>
        </div>
        <h3 class="text-xl tracking-tight font-semibold text-[#1a1a1a] mb-4">Brand Messaging</h3>
        <p class="text-lg text-[#666]   ">Crafting compelling messages that resonate with discerning clients and strengthens brand loyalty.</p>
      </div>
    </div>
  </div>
</section>

