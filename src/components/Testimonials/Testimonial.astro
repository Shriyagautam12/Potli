<section class="testimonial-carousel z-20 relative bg-white">
  <div class="container">
    <div class="carousel-wrapper">
      <div class="testimonial-grid">
        <!-- Left Content -->
        <div class="testimonial-content relative">
          <blockquote class="testimonial-quote" id="testimonial-quote">
            {testimonials[0].quote}
          </blockquote>

          <div class="rating">
            <div class="flex gap-1">
              <Star size={"20px"} fill="#000" />
              <Star size={"20px"} fill="#000" />
              <Star size={"20px"} fill="#000" />
              <Star size={"20px"} fill="#000" />
              <Star size={"20px"} fill="#000" />
            </div>
            <div class="client-info" id="client-info">
              {testimonials[0].author} from {testimonials[0].company}
            </div>
          </div>
          <div
            class="testimonial-navigation static mt-4 md:absolute md:bottom-0 md:right-10"
          >
            <button
              class="nav-button prev"
              id="prev-btn"
              aria-label="Previous testimonial"
            >
              <ChevronLeft size="24px" />
            </button>
            <button
              class="nav-button next"
              id="next-btn"
              aria-label="Next testimonial"
            >
              <ChevronRight size="24px" />
            </button>
          </div>
        </div>

        <!-- Right Image -->
        <div class="testimonial-image">
          <img
            id="testimonial-image"
            src={testimonials[0].image}
            alt={testimonials[0].alt}
          />
        </div>
      </div>

      <!-- Navigation arrows -->

      <!-- Dots indicator -->
      <div class="carousel-indicators">
        {
          testimonials.map((_, index) => (
            <button
              class={`indicator-dot ${index === 0 ? "active" : ""}`}
              data-index={index}
              aria-label={`Go to testimonial ${index + 1}`}
            />
