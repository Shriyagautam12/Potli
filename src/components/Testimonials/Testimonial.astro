<style>
  .testimonial-carousel {
    padding: 120px 0;
    background-color: #efeae5;
    position: relative;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  .carousel-wrapper {
    position: relative;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;

    align-items: center;
    min-height: 600px;
  }
  .testimonial-quote.small-text {
    font-size: 20px;
    line-height: 1.5;
    font-weight: 400;
  }

  .testimonial-content {
    padding-right: 40px;
    height: 100%;
    opacity: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transform: translateX(0);
    transition: all 0.5s ease;
  }

  .testimonial-content.fade-out {
    opacity: 0;
    transform: translateX(-20px);
  }

  .testimonial-quote {
    font-size: 3rem;
    font-weight: 600;
    line-height: 1.2;
    color: #1a1a1a;
    margin: 0 0 40px 0;
    font-style: normal;
  }

  .rating {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stars {
    display: flex;
    gap: 4px;
    color: #1a1a1a;
  }

  .client-info {
    font-size: 1rem;
    color: #666;
    font-weight: 400;
  }

  .testimonial-image {
    position: relative;
    height: 500px;
    border-radius: 24px;
    overflow: hidden;
    opacity: 1;
    transform: translateX(0);
    transition: all 0.5s ease;
  }

  .testimonial-image.fade-out {
    opacity: 0;
    transform: translateX(20px);
  }

  .testimonial-image img {
    width: 100%;
    object-fit: cover;
    border-radius: 24px;
    object-position: center;
    transition: all 0.5s ease;
  }

  .testimonial-navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .nav-button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: #a1806e;
    backdrop-filter: blur(10px);
  }

  .nav-button:hover {
    background: #e3dad2;
    transform: scale(1.05);
  }

  .nav-button:active {
    transform: scale(0.95);
  }

  .nav-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .carousel-indicators {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .indicator-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background: #e3dad2;
    transition: all 0.3s ease;
  }

  .indicator-dot.active {
    background: #a1806e;
    transform: scale(1.2);
  }

  .indicator-dot:hover {
    background: #666;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .testimonial-grid {
      gap: 60px;
    }

    .testimonial-content {
      padding-right: 20px;
    }

    .testimonial-quote {
      font-size: 2.5rem;
    }

    .testimonial-image {
      height: 500px;
    }
  }

  @media (max-width: 768px) {
    .testimonial-carousel {
      padding: 80px 0;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .testimonial-content {
      padding-right: 0;
      text-align: center;
      order: 2;
    }

    .testimonial-image {
      height: 400px;
      order: 1;
    }

    .testimonial-quote {
      font-size: 2rem;
      margin-bottom: 32px;
    }

    .rating {
      align-items: center;
    }

    .testimonial-navigation {
      bottom: 40px;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 16px;
    }

    .testimonial-quote {
      font-size: 1.75rem;
    }

    .testimonial-image {
      height: 350px;
    }

    .nav-button {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .testimonial-carousel {
      padding: 60px 0;
    }

    .testimonial-quote {
      font-size: 1.5rem;
    }

    .testimonial-grid {
      gap: 30px;
    }

    .testimonial-image {
      height: 300px;
      border-radius: 16px;
    }

    .testimonial-navigation {
      bottom: 30px;
    }
  }
</style>
<script define:vars={{ testimonials }}>
  document.addEventListener("DOMContentLoaded", () => {
    let currentIndex = 0;
    const total = testimonials.length;

    const quoteEl = document.getElementById("testimonial-quote");
    const clientEl = document.getElementById("client-info");
    const imageEl = document.getElementById("testimonial-image");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");
    const dots = document.querySelectorAll(".indicator-dot");
    const content = document.querySelector(".testimonial-content");
    const imageBox = document.querySelector(".testimonial-image");

    function updateTestimonial(index) {
      const t = testimonials[index];

      content.classList.add("fade-out");
      imageBox.classList.add("fade-out");

      setTimeout(() => {
        quoteEl.textContent = t.quote;

        // Smaller font only for long testimonial
        if (index === 3) {
          quoteEl.classList.add("small-text");
        } else {
          quoteEl.classList.remove("small-text");
        }

        clientEl.textContent = `${t.author} from ${t.company}`;
        imageEl.src = t.image;
        imageEl.alt = t.alt || "";

        dots.forEach((dot, i) => dot.classList.toggle("active", i === index));

        content.classList.remove("fade-out");
        imageBox.classList.remove("fade-out");
      }, 400);
    }

    function next() {
      currentIndex = (currentIndex + 1) % total;
      updateTestimonial(currentIndex);
    }

    function prev() {
      currentIndex = (currentIndex - 1 + total) % total;
      updateTestimonial(currentIndex);
    }

    nextBtn?.addEventListener("click", next);
    prevBtn?.addEventListener("click", prev);

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        if (i !== currentIndex) {
          currentIndex = i;
          updateTestimonial(i);
        }
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") next();
      if (e.key === "ArrowLeft") prev();
    });
  });
</script>
