---
// TestimonialCarousel.astro
import { ChevronRight, ChevronLeft, Star } from "@lucide/astro";
// Sample testimonial data - you can replace this with your actual data
const testimonials = [
  {
    id: 1,
    quote:
      "Potli completely reimagined our brand, creating a visual identity with Rosemin's essence.",
    author: "Rosemin",
    company: "Personal Branding",
    image: "/assets/Person1.jpeg",
    alt: "Rosemin from Personal Branding",
  },
  {
    id: 2,
    quote:
      "Working with Potli was transformative. They captured our vision perfectly and delivered beyond expectations.",
    author: "Yannis Alexandrides",
    company: "111Skin",
    image: "/assets/Person2.jpeg",
    alt: "Yannis Alexandrides from 111Skin",
  },
  {
    id: 3,
    quote:
      "The attention to detail and strategic approach from Potli elevated our brand to new heights.",
    author: "Karolina Antoniades",
    company: "Personal Branding",
    image: "/assets/Person3.jpeg",
    alt: "Karolina Antoniades from Personal Branding",
  },
  {
    id: 4,
    quote:
      "Potli, as the Branding Partner for Talimi Mela: The Evighet, played a defining role in ushering the festival into a new era. Their vision went far beyond visual identity. From conceptual narrative to on ground curation, Potli reimagined the entire experience of Talimi Mela, giving it a cohesive, contemporary, and culturally rooted expression. The scale, structure, and storytelling of the event reflected a rare depth of strategic thinking and creative discipline. The Evighet edition stands as a landmark moment in Jamia’s history, setting a new benchmark for how student led cultural festivals can be curated, experienced, and remembered.",
    author: " ",
    company: "Jamia Milia Islamia",
    image: "/assets/jamia.png",
