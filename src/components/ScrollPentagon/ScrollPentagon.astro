---
const circles = Array.from({ length: 5 }, (_, index) => index);
const labels = [
  ["Clarity through", "strategy"],
  ["People at", " the center"],
  ["Make complex", "simple"],
  ["Build brands", " that people love"],
  ["Create across ", "disciplines"],
];
---

<section
  data-pentagon-scroll
  class="relative min-h-[100vh] bg-[#EFEAE5]"
  aria-label="Scroll animated pentagon circles"
>
  <div class="sticky top-0 h-screen overflow-hidden">
    <div class="relative h-full w-full">
      {
        circles.map((index) => (
          <div
            data-pentagon-circle
            data-circle-index={index}
            class="absolute left-1/2 top-1/2 -translate-1/2 rounded-full border-4 border-black bg-transparent"
            style="width: 4px; height: 4px;"
          >
            <span
              data-pentagon-label
              class="absolute left-1/2 top-1/2 flex w-max -translate-1/2 flex-col items-center justify-center gap-1 text-center font-medium leading-tight text-black"
              style="opacity: 0; scale: 0; transform-origin: 50% 50%;"
            >
              {labels[index].map((line) => (
                <span class="block whitespace-nowrap">{line}</span>
              ))}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const triggerId = "pentagon-scroll-trigger";

  const getPentagonPoints = () => {
    const radius = Math.min(window.innerWidth, window.innerHeight) * 0.25;
    const xRadius = radius * 1.05;
    const yRadius = radius * 0.9;
    const startAngle = -Math.PI / 2;

    return Array.from({ length: 5 }, (_, index) => {
      const angle = startAngle + (Math.PI * 2 * index) / 5;

      return {
        x: Math.cos(angle) * xRadius,
        y: Math.sin(angle) * yRadius,
      };
    });
  };

  const setupPentagonScroll = () => {
    const section = document.querySelector("[data-pentagon-scroll]");
    const circles = Array.from(
      document.querySelectorAll("[data-pentagon-circle]"),
    );
    const labels = Array.from(
      document.querySelectorAll("[data-pentagon-label]"),
    );

    if (!section || circles.length !== 5 || labels.length !== 5) return;

    ScrollTrigger.getById(triggerId)?.kill();

    gsap.set(circles, {
      x: 0,
      y: 0,
      xPercent: -50,
      yPercent: -50,
      willChange: "transform",
      transformOrigin: "50% 50%",
    });

    gsap.set(labels, {
      opacity: 0,
      scale: 0,
      transformOrigin: "50% 50%",
    });

    const timeline = gsap.timeline({
      scrollTrigger: {
        id: triggerId,
        trigger: section,
        start: "top top",
        end: () => `+=${window.innerHeight * 1}`,
        scrub: 2,
        invalidateOnRefresh: true,
        pin: true,
      },
      defaults: { ease: "none" },
    });

    timeline.to(circles, {
      x: (index) => getPentagonPoints()[index].x,
      y: (index) => getPentagonPoints()[index].y,
      duration: 1,
      borderWidth: 2,
    });

    timeline.to(circles, {
      width: 200,
      height: 200,
      duration: 1,
    });

    timeline.to(
      labels,
      {
        opacity: 1,
        scale: 1,
        duration: 1,
      },
      1,
    );

    ScrollTrigger.refresh();
  };

  const start = () => requestAnimationFrame(setupPentagonScroll);

  if (document.readyState === "complete") {
    start();
  } else {
    window.addEventListener("load", start, { once: true });
  }

  document.addEventListener("astro:page-load", start);
</script>
