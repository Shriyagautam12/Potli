---
// src/components/FAQ.astro
import {ChevronDown} from "@lucide/astro"

const faqs = [
  {
    question: "What types of brands do you work with?",
    answer:
      "We specialize in working with luxury brands that prioritize quality, elegance, and distinction. Our expertise spans industries such as beauty, lifestyle, hospitality, fashion, and premium services. If your brand seeks to create a Potli impression and resonate with discerning audiences, we’re here to help.",
  },
  {
    question: "How long does the branding process take?",
    answer:
      "The timeline depends on the scope of your project, but most branding processes take between 4–8 weeks.",
  },
  {
    question: "Do you offer custom branding packages?",
    answer:
      "Yes, we tailor our branding packages to meet the specific needs of each client.",
  },
  {
    question: "Will I receive all the files needed for my brand?",
    answer:
      "Absolutely. You’ll receive all design assets, source files, and guidelines required to manage your brand.",
  },
  {
    question: "What makes Potli different from other branding agencies?",
    answer:
      "Our focus on Potli design ensures your brand stands out and remains relevant for years to come.",
  },
];
---

<section class="w-full mx-auto px-4 py-16 text-center z-20 relative bg-white pb-36">
  <h2 class="text-4xl font-medium tracking-tight text-[#1a1a1a] text-center">Frequently asked questions</h2>
  <p class="text-[#666] text-base md:text-xl text-center mt-2 md:mt-4 mb-16 md:w-auto w-4/5 mx-auto">We’ve answered your top questions to show how we can transform your brand.</p>

  <div class="w-[90%] md:w-3/5 mx-auto text-left">
    {faqs.map((faq, index) => (
      <details class="border-b border-[#eee] py-4 group">
        <summary class="cursor-pointer flex items-center justify-between font-medium text-lg outline-0 list-none">
          {faq.question}
          <ChevronDown  class="group-open:rotate-180 min-w-6 transform transition-all duration-[350ms] ease-in-out"/>
        </summary>
        <p class="text-[#818181] mt-2 ">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

