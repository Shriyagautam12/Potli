---
import Layout from "../../layouts/Layout.astro";
import HomeMenu from "../../components/HomeMenu.astro";
import ScrollTextSequence from "../../components/ScrollTextSequence/ScrollTextSequence.astro";
import ScrollPentagon from "../../components/ScrollPentagon/ScrollPentagon.astro";
import Footer from "../../components/Footer/Footer.astro";
---

<Layout class="">
  <HomeMenu slot="menu" />
  <ScrollTextSequence />
  <ScrollPentagon />
  <section class="w-full py-36 bg-[#EFEAE5] items-center flex flex-col">
    <h2 class="text-4xl font-medium tracking-tight text-[#1a1a1a] text-center">
      Team
    </h2>
    <p
      class="text-[#666] text-xl text-center mt-2 md:mt-4 mb-16 md:w-auto w-4/5 mx-auto"
    >
      Our Team at Potli
    </p>
    <div class="columns-1 md:columns-5 w-full h-fit gap-2 px-8 pt-14">
      <div class="flex w-full h-[680px] md:h-96 rounded-xl break-inside-avoid flex-col mb-4">
        <div
          class="w-full h-full bg-[#A1806E] rounded-lg relative overflow-hidden group"
        >
          <div
            class="w-full h-full bg-black text-white hidden group-hover:grid grid-cols-3 px-4 text-sm leading-tight pt-20 pb-2 gap-y-1"
          >
            <!-- <div class="flex gap-2"> -->
            <p class="text-[#666] flex w-fit">Name:</p>
            <p class="w-full flex col-span-2">Rushan Ahmad</p>
            <!-- </div> -->
            <!-- <div class="flex gap-2"> -->
            <p class="text-[#666] flex w-fit">Role:</p>
            <p class="w-full flex col-span-2">
              Founder & <br /> Managing Consultant
            </p>
            <!-- </div>
          <div class="flex gap-2"> -->
            <p class="text-[#666] flex w-fit">About:</p>
            <p class="w-full flex col-span-2">
              I work with businesses at defining moments, helping them make
              sense of where they are, where they're headed, and what it will
              take to get there.
            </p>
            <!-- </div> -->
          </div>
          <img
            src="/assets/Rushan.jpeg"
            alt=""
            class="w-full h-full object-cover"
          />
        </div>
        <div class="p-2 h-fit">
          <h3 class="text-xl">Rushan Ahmad</h3>
          <p class="text-base leading-tight text-[#666]">
            Founder & <br /> Managing Consultant
          </p>
        </div>
      </div>

      <div class="flex w-full h-[680px] md:h-96 rounded-xl break-inside-avoid flex-col mb-4">
