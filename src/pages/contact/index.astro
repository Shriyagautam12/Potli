<script is:inline>
  // scroll reveal
  const els = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold:0.12, rootMargin:'0px 0px -60px 0px'});
  els.forEach(el=>io.observe(el));

  // nav shadow on scroll
  const pill = document.querySelector('.nav-pill');
  window.addEventListener('scroll', ()=>{
    pill.style.boxShadow = window.scrollY > 40
      ? '0 14px 34px -12px rgba(34,30,26,0.28)'
      : '0 10px 30px -12px rgba(34,30,26,0.18)';
  });

  // logo draw animation
  const logoFigure = document.getElementById('logoFigure');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (logoFigure && !reducedMotion) {
    try {
      const drawPaths = () => Array.from(logoFigure.querySelectorAll('.lg-vessel, .lg-divider, .lg-ring'));
      const runSequence = () => {
        const paths = drawPaths();
        paths.forEach((el) => {
          const len = Math.ceil(el.getTotalLength());
          el.style.transition = 'none';
          el.style.strokeDasharray = len;
          el.style.strokeDashoffset = len;
        });
        paths.forEach((el) => el.getBoundingClientRect());
        paths.forEach((el) => {
          el.style.transition = '';
          el.style.strokeDashoffset = '0';
        });
        const ringGroup = logoFigure.querySelector('.lg-ring-group');
        if (ringGroup) {
          ringGroup.style.animation = 'none';
          void ringGroup.offsetWidth;
          ringGroup.style.animation = '';
        }
      };
      runSequence();
      logoFigure.addEventListener('click', runSequence);
      logoFigure.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); runSequence(); }
      });
    } catch (err) {
      console.error('Logo animation failed to initialize:', err);
    }
  }

  // form submit
  const form = document.getElementById('contactForm');
  const success = document.getElementById('successMsg');
  const errorMsg = document.getElementById('errorMsg');
  const submitBtn = form.querySelector('.btn-primary');
  const submitLabel = submitBtn.querySelector('.btn-label');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    success.classList.remove('show');
    errorMsg.classList.remove('show');
    submitBtn.setAttribute('disabled', 'true');
    submitLabel.textContent = 'Sending…';

    const ajaxUrl = form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/');

    fetch(ajaxUrl, {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form)
    })
      .then((res) => {
        if (!res.ok) throw new Error('Request failed');
        success.classList.add('show');
        form.reset();
      })
      .catch(() => {
        errorMsg.classList.add('show');
      })
      .finally(() => {
        submitBtn.removeAttribute('disabled');
        submitLabel.textContent = 'Send it our way';
      });
  });
</script>
<script>
  import { gsap } from "gsap";

  const mouseFollower = document.getElementById("mouse-follower");
  if (mouseFollower) {
    gsap.set(mouseFollower, { xPercent: -50, yPercent: -50 });

    const xTo = gsap.quickTo(mouseFollower, "x", { duration: 0.6, ease: "power3" });
    const yTo = gsap.quickTo(mouseFollower, "y", { duration: 0.6, ease: "power3" });

    window.addEventListener("mousemove", (e) => {
      xTo(e.clientX);
      yTo(e.clientY);
    });
  }
</script>

