---
import Hero from '../components/HeroSection/Hero.astro';
import BrandQuote from '../components/BrandQuote/BrandQuote.astro';
import WhatWeDo from '../components/WhatWeDo/WhatWeDo.astro';
import Layout from '../layouts/Layout.astro';
import WhyPotli from '../components/WhyPotli/WhyPotli.astro';
import Features from '../components/Features/Features.astro';
import Testimonial from '../components/Testimonials/Testimonial.astro';
import Faq from '../components/Faq/faq.astro';
import Footer from '../components/Footer/Footer.astro';
import Awards from '../components/Awards/Awards.astro';





// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<!-- <Welcome /> -->
	 <!-- <div class="pointer-events-none w-full fixed h-64 left-0 top-0 -translate-y-1/2 backdrop-blur-3xl [mask-image:linear-gradient(to_bottom,transparent_0%,white_40%,transparent_80%,transparent_100%)] [mask-size:100%_120%] [mask-position:0_-10%] z-50"></div> -->
		<Hero />
		<!-- <div class="h-screen w-full pointer-events-none"></div> -->
		<BrandQuote />
		<WhatWeDo />
		<WhyPotli/>
		<Features/>
		<Testimonial/>
		<Awards/>
		<Faq/>
		<Footer/>
</Layout>
<script>
  import {gsap} from "gsap";
  import { ScrollTrigger } from "gsap/all";
  gsap.registerPlugin(ScrollTrigger);

  //hero section animation
  const herodiv=document.getElementById("herodiv");
  const testimonial=document.getElementById("testimonial");
  gsap.to(herodiv,{
    yPercent:8,
    scrollTrigger:{
      trigger:testimonial,
	  start:"top 100%",
	  end:"top 0%",
	  scrub:1,
	//   markers:true,
    }
  })

  //why potli section animation
  const grid=document.getElementById("whyPotliGrid")
  const hand1=document.getElementById("left-hand")
  const handdiv=document.getElementById("hand-div")
  const hand2=document.getElementById("right-hand")
  const spinner=document.getElementById("spinner")
  const spinnerdiv=document.getElementById("spinner-div")
  const imagediv=document.getElementById("whyPotliImageDiv")
  const whyPotliImage=document.getElementById("whyPotliImage")

  gsap.from(hand1,{
	xPercent:-40,
	scrollTrigger:{
		trigger:handdiv,
		start:"top 100%",
		end:"80% 100%",
		scrub:1,
		// markers:true
	}
  })
  gsap.from(hand2,{
	xPercent:40,
	scrollTrigger:{
		trigger:grid,
		start:"top 100%",
		end:"80% 100%",
		scrub:1,
		// markers:true
	}
  })
  gsap.from(spinner,{
	scale:1.4,
	scrollTrigger:{
		trigger:spinnerdiv,
		start:"top 100%",
		end:"80% 100%",
		scrub:1,
		// markers:true
	}
  })
  gsap.from(whyPotliImage,{
	scale:1.2,
	scrollTrigger:{
		trigger:imagediv,
		start:"top 100%",
		end:"bottom 80%",
		scrub:1,
		// markers:true
	}
  })
  //feature
  const featureCards=document.querySelectorAll(".feature-card")
    const featureContainer=document.getElementById("feature-container")
  gsap.from(featureCards, {
        opacity: 0,
        y: 30,
        duration: 0.8,
        ease: "power3.out",
        stagger: 0.18,
        scrollTrigger: {
          trigger: featureContainer,
          start: "top 70%",       
          toggleActions: "play none none none",
		//   markers:true,
		//   scrub:1
        },
      });
  //feature
  const whatWeDoCards=document.querySelectorAll(".whatwedo-card")
  
  const whatWeDoContainer=document.getElementById("container2")
  gsap.from(whatWeDoCards, {
        opacity: 0,
        y: 30,
        duration: 0.8,
        ease: "power3.out",
        stagger: 0.18,
        scrollTrigger: {
          trigger: whatWeDoContainer,
          start: "top 70%",       
          toggleActions: "play none none none",
		//   scrub:1
        },
      });
  
  </script>